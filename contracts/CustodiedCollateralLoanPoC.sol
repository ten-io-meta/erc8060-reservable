pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC721/IERC721.sol";
import "@openzeppelin/contracts/token/ERC721/IERC721Receiver.sol";
import "@openzeppelin/contracts/security/ReentrancyGuard.sol";
import "./reference/IERC721ValueReference.sol";

/// @title CustodiedCollateralLoanPoC
/// @notice EXPERIMENTAL fixed-ETH loan against an NFT whose native-ETH redemption
///         is controlled by this contract as the ACTUAL ERC721 owner.
/// @dev A reservation alone cannot pay a lender. This alternative uses NFT
///      custody + actual loan funding + verifiable burn payout + pull payments.
///      No DEX, oracle, offchain proof, market-value auction or legal enforcement.
///      Offchain dispute decisions trust a named arbiter, with deterministic
///      fallback to the agreed onchain default if that arbiter is unavailable.
///      Not audited. Never use this lab implementation for real user funds.
contract CustodiedCollateralLoanPoC is IERC721Receiver, ReentrancyGuard {
    uint256 public constant MAX_FUNDING_WINDOW = 30 days;
    uint256 public constant MAX_LOAN_TERM = 365 days;
    uint256 public constant MAX_GRACE = 30 days;
    uint256 public constant MAX_CHALLENGE = 30 days;
    uint256 public constant MAX_ARBITER_WINDOW = 30 days;

    IERC721 public immutable nft;
    IERC721ValueReference public immutable valueNft;

    enum State {
        Unknown, Proposed, Active, Repaid, Defaulted, Disputed,
        Forgiven, Liquidated, NFTReturned, Cancelled
    }

    struct Loan {
        uint256 tokenId;
        address borrower;
        address lender;
        address arbiter;
        uint256 principal;
        uint256 payoff;
        uint256 repaid;
        uint64 fundingDeadline;
        uint64 term;
        uint64 grace;
        uint64 challenge;
        uint64 arbitrateFor;
        uint64 dueAt;
        uint64 defaultAt;
        bytes32 termsHash;
        State state;
    }

    struct Offer {
        uint256 tokenId;
        address lender;
        address arbiter;
        uint256 principal;
        uint256 payoff;
        uint64 fundingDeadline;
        uint64 term;
        uint64 grace;
        uint64 challenge;
        uint64 arbitrateFor;
        bytes32 termsHash;
    }

    uint256 public nextLoanId = 1;
    mapping(uint256 => Loan) private _loans;

    /// @notice Explicit struct return avoids a stack-heavy autogenerated getter.
    function loanInfo(uint256 id) external view returns (Loan memory) {
        return _loans[id];
    }
    mapping(address => uint256) public credits;
    uint256 public totalCredits;

    bool private expectingNFT;
    address private expectedFrom;
    uint256 private expectedTokenId;

    event Proposed(uint256 indexed loanId, uint256 indexed tokenId, address indexed borrower, address lender);
    event Cancelled(uint256 indexed loanId);
    event Funded(uint256 indexed loanId, uint256 amount, uint64 dueAt);
    event Repaid(uint256 indexed loanId, address indexed payer, uint256 amount, uint256 totalRepaid);
    event Defaulted(uint256 indexed loanId, uint64 defaultAt);
    event Disputed(uint256 indexed loanId, address indexed challenger);
    event Arbitrated(uint256 indexed loanId, bool forgiveOutstanding);
    event Liquidated(uint256 indexed loanId, uint256 redeemed, uint256 lenderAward, uint256 borrowerSurplus);
    event NFTReleased(uint256 indexed loanId, address indexed receiver);
    event CreditWithdrawn(address indexed creditor, address indexed recipient, uint256 amount);

    constructor(address nft_) {
        require(nft_ != address(0) && nft_.code.length != 0, "invalid NFT");
        nft = IERC721(nft_);
        valueNft = IERC721ValueReference(nft_);
    }

    /// @notice Borrower commits the NFT and precise financial terms before
    ///         a named lender can fund. Lender must read the terms independently.
    /// @dev Collection is immutable, but its source and real ETH solvency still
    ///      require independent verification. Arbitrary ERC165 claims prove nothing.
    function propose(Offer calldata o) external nonReentrant returns (uint256 id) {
        require(nft.ownerOf(o.tokenId) == msg.sender, "not NFT owner");
        require(o.lender != address(0) && o.lender != msg.sender, "invalid lender");
        require(o.arbiter != address(0) && o.arbiter != o.lender
                && o.arbiter != msg.sender, "invalid arbiter");
        require(o.principal > 0 && o.payoff >= o.principal, "invalid payoff");
        require(o.termsHash != bytes32(0), "missing terms");
        require(uint256(o.fundingDeadline) > block.timestamp
                && uint256(o.fundingDeadline) <= block.timestamp + MAX_FUNDING_WINDOW,
                "invalid funding deadline");
        require(o.term > 0 && o.term <= MAX_LOAN_TERM, "invalid term");
        require(o.grace <= MAX_GRACE, "invalid grace");
        require(o.challenge > 0 && o.challenge <= MAX_CHALLENGE, "invalid challenge");
        require(o.arbitrateFor > 0 && o.arbitrateFor <= MAX_ARBITER_WINDOW,
                "invalid arbitration period");
        require(valueNft.valueOf(o.tokenId) >= o.payoff, "insufficient ETH backing");

        id = nextLoanId++;
        Loan storage l = _loans[id];
        l.tokenId = o.tokenId;
        l.borrower = msg.sender;
        l.lender = o.lender;
        l.arbiter = o.arbiter;
        l.principal = o.principal;
        l.payoff = o.payoff;
        l.fundingDeadline = o.fundingDeadline;
        l.term = o.term;
        l.grace = o.grace;
        l.challenge = o.challenge;
        l.arbitrateFor = o.arbitrateFor;
        l.termsHash = o.termsHash;
        l.state = State.Proposed;

        expectingNFT = true;
        expectedFrom = msg.sender;
        expectedTokenId = o.tokenId;
        nft.safeTransferFrom(msg.sender, address(this), o.tokenId);
        expectingNFT = false;
        expectedFrom = address(0);
        expectedTokenId = 0;
        require(nft.ownerOf(o.tokenId) == address(this), "NFT not deposited");

        emit Proposed(id, o.tokenId, msg.sender, o.lender);
    }

    /// @notice Only the lender named in the borrower-signed proposal can fund.
    ///         Principal is transferred to the borrower atomically with funding.
    function fund(uint256 id, bytes32 expectedTermsHash) external payable nonReentrant {
        Loan storage l = _loans[id];
        require(l.state == State.Proposed, "not proposed");
        require(msg.sender == l.lender, "not lender");
        require(expectedTermsHash == l.termsHash, "terms mismatch");
        require(block.timestamp <= l.fundingDeadline, "funding expired");
        require(msg.value == l.principal, "wrong principal");
        require(nft.ownerOf(l.tokenId) == address(this), "collateral missing");
        require(valueNft.valueOf(l.tokenId) >= l.payoff, "insufficient ETH backing");

        l.state = State.Active;
        l.dueAt = uint64(block.timestamp + l.term);

        (bool ok, ) = payable(l.borrower).call{value: msg.value}("");
        require(ok, "borrower cannot receive ETH");
        emit Funded(id, msg.value, l.dueAt);
    }

    /// @notice An unfunded offer can be cancelled; the NFT returns to any
    ///         recipient chosen by the authenticated borrower.
    function cancelUnfunded(uint256 id, address recipient) external nonReentrant {
        Loan storage l = _loans[id];
        require(l.state == State.Proposed, "not proposed");
        require(msg.sender == l.borrower, "not borrower");
        require(recipient != address(0), "invalid receiver");
        l.state = State.Cancelled;
        nft.safeTransferFrom(address(this), recipient, l.tokenId);
        emit Cancelled(id);
    }

    /// @notice Anyone can repay onchain before dueAt + grace. Each wei is
    ///         credited to the lender exactly once, with no external call.
    function repay(uint256 id) external payable nonReentrant {
        Loan storage l = _loans[id];
        require(l.state == State.Active, "not active");
        require(block.timestamp <= uint256(l.dueAt) + l.grace, "repayment closed");
        uint256 outstanding = l.payoff - l.repaid;
        require(msg.value > 0 && msg.value <= outstanding, "invalid payment");

        l.repaid += msg.value;
        credits[l.lender] += msg.value;
        totalCredits += msg.value;
        if (l.repaid == l.payoff) l.state = State.Repaid;
        emit Repaid(id, msg.sender, msg.value, l.repaid);
    }

    /// @notice Fully repaid or arbiter-forgiven obligations return the NFT to
    ///         the authenticated borrower (or an explicit nominated recipient).
    function claimCollateral(uint256 id, address recipient) external nonReentrant {
        Loan storage l = _loans[id];
        require(l.state == State.Repaid || l.state == State.Forgiven, "not releasable");
        require(msg.sender == l.borrower, "not borrower");
        require(recipient != address(0), "invalid receiver");
        l.state = State.NFTReturned;
        nft.safeTransferFrom(address(this), recipient, l.tokenId);
        emit NFTReleased(id, recipient);
    }

    function declareDefault(uint256 id) external nonReentrant {
        Loan storage l = _loans[id];
        require(l.state == State.Active, "not active");
        require(block.timestamp > uint256(l.dueAt) + l.grace, "still repayable");
        l.state = State.Defaulted;
        l.defaultAt = uint64(block.timestamp);
        emit Defaulted(id, l.defaultAt);
    }

    /// @notice Either named party may challenge a default. A nonresponsive
    ///         arbiter cannot keep the NFT locked forever: fallback applies
    ///         the pre-agreed onchain payment ledger/default rule.
    function dispute(uint256 id) external nonReentrant {
        Loan storage l = _loans[id];
        require(l.state == State.Defaulted, "not defaulted");
        require(msg.sender == l.borrower || msg.sender == l.lender, "not a party");
        require(block.timestamp <= uint256(l.defaultAt) + l.challenge, "challenge closed");
        l.state = State.Disputed;
        emit Disputed(id, msg.sender);
    }

    /// @notice Trusted arbitrator may acknowledge offchain satisfaction.
    ///         This power can forgive remaining debt and therefore MUST be
    ///         explicitly accepted by both parties; otherwise use onchain-only
    ///         lending with no external adjudication.
    function arbitrate(uint256 id, bool forgiveOutstanding) external nonReentrant {
        Loan storage l = _loans[id];
        require(l.state == State.Disputed, "not disputed");
        require(msg.sender == l.arbiter, "not arbiter");
        require(block.timestamp <= _resolutionDeadline(l), "arbitration expired");
        if (forgiveOutstanding) {
            l.state = State.Forgiven;
            emit Arbitrated(id, true);
        } else {
            emit Arbitrated(id, false);
            _liquidate(id, l);
        }
    }

    /// @notice Permissionless liquidation only after accepted challenge time,
    ///         and also after arbitration timeout if a dispute was raised.
    ///         Never releases collateral merely because the debt is due.
    function liquidate(uint256 id) external nonReentrant {
        Loan storage l = _loans[id];
        if (l.state == State.Defaulted) {
            require(block.timestamp > uint256(l.defaultAt) + l.challenge, "challenge open");
        } else if (l.state == State.Disputed) {
            require(block.timestamp > _resolutionDeadline(l), "arbitration open");
        } else {
            revert("not liquidatable");
        }
        _liquidate(id, l);
    }

    function _resolutionDeadline(Loan storage l) private view returns (uint256) {
        return uint256(l.defaultAt) + l.challenge + l.arbitrateFor;
    }

    function _liquidate(uint256 id, Loan storage l) private {
        uint256 expectedBacking = valueNft.valueOf(l.tokenId);
        uint256 owed = l.payoff - l.repaid;
        require(expectedBacking >= owed, "insufficient redeemable collateral");
        require(nft.ownerOf(l.tokenId) == address(this), "collateral missing");

        // Effect before external ETH callback. A revert on burn or mismatch
        // unwinds status, creditor balances, NFT burn and all ETH transfers.
        l.state = State.Liquidated;
        uint256 beforeBalance = address(this).balance;
        valueNft.burn(l.tokenId);
        uint256 received = address(this).balance - beforeBalance;
        require(received == expectedBacking, "wrong redemption payout");

        credits[l.lender] += owed;
        credits[l.borrower] += received - owed;
        totalCredits += received;
        emit Liquidated(id, received, owed, received - owed);
    }

    /// @notice Credits are independent from liquidation and never count
    ///         direct borrower funding as escrow-held money.
    ///         Recipient can be an EOA when a smart wallet rejects ETH.
    function withdrawCredit(address payable recipient) external nonReentrant {
        require(recipient != address(0), "invalid receiver");
        uint256 amount = credits[msg.sender];
        require(amount != 0, "no credit");
        credits[msg.sender] = 0;
        totalCredits -= amount;
        (bool sent, ) = recipient.call{value: amount}("");
        require(sent, "credit transfer failed");
        emit CreditWithdrawn(msg.sender, recipient, amount);
    }

    /// @notice Only accept the exact NFT currently being deposited by propose.
    function onERC721Received(address operator, address from, uint256 tokenId, bytes calldata)
        external view override returns (bytes4)
    {
        require(msg.sender == address(nft) && expectingNFT && operator == address(this)
            && from == expectedFrom && tokenId == expectedTokenId, "unsolicited NFT");
        return IERC721Receiver.onERC721Received.selector;
    }

    /// @notice ETH is received only from the immutable collateral collection.
    ///         Noncollateral forced donations must not inflate internal credits.
    receive() external payable {
        require(msg.sender == address(nft), "unexpected ETH sender");
    }
}
